# Strata inference server - Qwen3.8-Flash-Next on the RTX 3090 box.
#
# Serving only. The --profile file is the whole serving configuration: strata
# wrote the context, KV format and expert settings into it when setup ran, and
# `strata serve` has no flag for any of them.
#
# To serve a different pack or context, run ./setup.sh and point --profile at
# the run config it prints. `strata models list` shows what is installed.
#
# Installed by ./setup.sh, which symlinks this file into /etc/systemd/system
# and enables it.
[Unit]
Description=Strata Inference Server
After=network.target
[Service]
Type=exec
User=kran
Group=kran
ExecStart=/home/kran/.local/bin/strata serve --profile /home/kran/.local/share/strata/install/strata-unsloth-ud-iq4_xs.json --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
