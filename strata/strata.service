# Strata inference server - Qwen3.8-Flash-Next on the RTX 3090 box.
#
# The unit only serves. Downloading, context size and tuning are all decided by
# the one-off setup step (`strata.sh setup`, 256k by default) because strata
# launch daemonises its runtime and cannot be the supervised process, and
# because `strata serve` has no context flag - the context is written into the
# run config as --max-context at setup time.
#
# Installed by `strata.sh setup`, which symlinks this file into
# /etc/systemd/system and enables it.
[Unit]
Description=Strata Inference Server
After=network.target
[Service]
Type=exec
User=kran
Group=kran
WorkingDirectory=/home/kran/Code/kran/llm-experiments/strata
Environment=STRATA_MODEL=ud-iq4_xs
Environment=STRATA_PORT=8000
ExecStart=/home/kran/Code/kran/llm-experiments/strata/strata.sh
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
[Install]
WantedBy=multi-user.target
